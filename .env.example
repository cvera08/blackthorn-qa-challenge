# Copy this file to .env and fill in real values. .env is gitignored and
# should never be committed, this file only documents what's expected.
#
# These happen to be public demo credentials (saucedemo.com lists them on
# its own login page), but the suite treats them as secrets on principle:
# in a real project this is exactly where actual login credentials would
# go, and hardcoding them into test files is what we're avoiding here.

SAUCE_USERNAME=<yourUsername> # if you don't have it, contact @it
SAUCE_PASSWORD=<yourPassword> # if you don't have it, contact @it
SAUCE_LOCKED_USER=<lockedOutUsername> # seeded account used only to test the "locked out" login flow
