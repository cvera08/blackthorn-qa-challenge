# Copy this file to .env before running the suite. .env is gitignored and
# should never be committed, this file only documents what's expected.
#
# SauceDemo's demo credentials are public (saucedemo.com lists them right
# on its own login page), so real working values are included below and
# the suite runs out of the box. On a real project these would be actual
# secrets, filled in by whoever's running the suite, something like:
#   SAUCE_USERNAME=<yourUsername>  # if you don't have it, contact @it
#   SAUCE_PASSWORD=<yourPassword>  # if you don't have it, contact @it

SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_USER=locked_out_user
